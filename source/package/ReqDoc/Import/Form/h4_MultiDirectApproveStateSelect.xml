      <name>h4_frm_init_setState</name>
     </Item>
    </related_id>
    <sk_method_code>var states = parent.frameElement.dialogArguments.state;
var labels = parent.frameElement.dialogArguments.label;
const selectElements = document.querySelectorAll('select');

for (var i = 0; i &lt; selectElements.length; i++) {
    var ele = selectElements[i];
    var eleName = ele.name;
    if (eleName.indexOf("State") == 0) {
        for (var j = 0; j &lt; states.length; j++) {
            var newOption = document.createElement('option');
            newOption.text = labels[j];
            newOption.value = states[j];
            ele.appendChild(newOption);
        }
    }
}

return;
</sk_method_code>
