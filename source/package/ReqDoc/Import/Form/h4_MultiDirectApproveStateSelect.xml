        <sk_method_code>// 入力フィールドを全て取得
var elements = document.querySelectorAll('select');

// 入力値の取得
var strState = "";

for (var i = 0; i &lt; elements.length; i++) {

    var ele = elements[i];
    var eleName = ele.name;

    // 設定値の取得
    if (eleName == "State") {
        strState = ele.value;
    }
}

// ダイアログクローズ処理
parent.dialogArguments.dialog.close(strState);

return;</sk_method_code>
