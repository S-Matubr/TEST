        <sk_field_parent>h4_RevisioDialog</sk_field_parent>
        <sk_method_code>// フォームの値を取得しダイアログに返す
//入力値の警告もここ

const iomInv = aras.IomInnovator;

// 入力フィールドを全て取得
//debugger;
var texts = document.querySelectorAll('textarea');
var inputs = document.querySelectorAll('input');

var tmp1 = "";
var tmp2 = "";
var tmp3 = "";

// 入力値の取得
for (var i = 0; i &lt; texts.length; i++)
{
    var text = texts[i];
    if(text.name == "h4_frm_revision_summary")
    {
        tmp1 = text.value;
    }

    if(text.name == "h4_frm_revision_reason")
    {
        tmp2 = text.value;
    }
}

// 入力値の取得
for (var j = 0; j &lt; inputs.length; j++)
{
    var input = inputs[j];
    if(input.name == "h4_frm_check")
    {
        tmp3 = input.checked;
    }
}

if(tmp1 == "" || tmp2 == "")
{
    aras.AlertError(getUserMessageText("h4_C_E_0006"));
}
else
{
   // ダイアログクローズ処理
    parent.dialogArguments.dialog.close(tmp1+","+tmp2+","+tmp3); 
}

return;

function getUserMessageText(name) {
    var userMsgItem = iomInv.newItem("UserMessage", "get");
    userMsgItem.setAttribute("select", "text");
    userMsgItem.setProperty("name", name);
    userMsgItem = userMsgItem.apply();
    var msg = userMsgItem.getProperty("text", "");
    return msg;
}

</sk_method_code>
        <sk_method_comment>改訂ダイアログで入力した内容を取得する</sk_method_comment>
