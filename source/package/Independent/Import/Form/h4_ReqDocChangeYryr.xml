        <sk_method_code>/*
    マルQページ初期値設定画面の設定を取得
*/
const iomInv = aras.IomInnovator;
var reason = document.getElementById("MainDataForm").h4_yryr_reason.value;
if(!reason)
{
    var msg = getUserMessage("h4_C_E_0503");
    aras.AlertError(msg);
    return;
}

parent.dialogArguments.dialog.close(reason);
return;

// メッセージを取得
function getUserMessage(messageName){
            var userMsgItem =  aras.IomInnovator.newItem("UserMessage","get");
            userMsgItem.setAttribute("select","text");
            userMsgItem.setProperty("name",messageName);
            userMsgItem = userMsgItem.apply();
            return  userMsgItem.getProperty("text","");
};</sk_method_code>
