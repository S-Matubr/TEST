   <Item type="Form Event" id="7633BE04499A4400A327E6263564439F" action="add">
    <form_event>onload</form_event>
    <related_id keyed_name="h4_frm_init_DATMasterCopydelta" type="Method">
     <Item type="Method" action="get" select="id">
      <name>h4_frm_init_DATMasterCopydelta</name>
     </Item>
    </related_id>
    <sk_method_code>var deltaVersions = parent.frameElement.dialogArguments.deltaVersion;
var labels = parent.frameElement.dialogArguments.label;
const selectElements = document.querySelectorAll('select');

for (var i = 0; i &lt; selectElements.length; i++) {
    var ele = selectElements[i];
    var eleName = ele.name;
    if (eleName.indexOf("DeltaVersion") == 0) {
        for (var j = 0; j &lt; deltaVersions.length; j++) {
            var newOption = document.createElement('option');
            newOption.text = labels[j];
            newOption.value = deltaVersions[j];
            ele.appendChild(newOption);
        }
    }
}

return;</sk_method_code>
