        </related_id>
        <sk_field_parent>h4_DATMasterCopyInputInitVal</sk_field_parent>
        <sk_method_code>// 入力フィールドを全て取得
var elements = document.querySelectorAll('select');

// 入力値の取得
var strDeltaVersion = "";
var strName = "";

for (var i = 0; i &lt; elements.length; i++) {

    var ele = elements[i];
    var eleName = ele.name;

    // ⊿バージョンの取得
    if (eleName == "DeltaVersion") {
        strDeltaVersion = ele.value;
    }
}

elements = document.querySelectorAll('input');

for (var i = 0; i &lt; elements.length; i++) {

    var ele = elements[i];
    var eleName = ele.name;

    // 名称の取得
    if (eleName == "Name") {
        strName = ele.value;
    }
}

// ダイアログクローズ処理
parent.dialogArguments.dialog.close(strDeltaVersion+","+strName);

return;</sk_method_code>
